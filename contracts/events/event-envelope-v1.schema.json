{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isaac.local/contracts/events/event-envelope-v1.schema.json",
  "title": "ISAAC Event Envelope v1",
  "type": "object",
  "required": ["id", "type", "version", "sequence", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "pattern": "^isaac\\.[a-z0-9_.-]+$" },
    "version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "correlationId": { "type": ["string", "null"] },
    "conversationId": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}
